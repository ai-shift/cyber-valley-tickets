[Unit]
Description=Cyber Valley Tickets - Vite Frontend
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/code/aishift/tickets
Environment="PATH=%h/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin"
ExecStart=make -C client/ run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
