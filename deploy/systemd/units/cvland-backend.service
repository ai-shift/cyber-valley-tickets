[Unit]
Description=Cyber Valley Tickets - Django Backend
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/code/aishift/tickets
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=make -C backend/ run-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
